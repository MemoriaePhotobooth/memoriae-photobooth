rules_version = '2';


service cloud.firestore {
  match /databases/{database}/documents {

    match /bookings/{bookingId} {
     
      allow create: if !isBlockedUser(request.resource.data.get('userId', ''));
    
      allow read: if true;

      // Staff/admin can change anything. A customer (who may be a guest with
      // no Firebase login, so we can't check WHO they are) may only do the
      // few things the customer app really does:
      //   * edit / pay for / release their own booking WHILE it is still an
      //     unpaid hold (`awaiting_receipt`) - never approve, confirm or
      //     complete it;
      //   * clear the notification bell (notifyCustomer -> false);
      //   * get a first invoice number.
      allow update: if isStaff() || isAdmin() || customerBookingEdit();

      // Completed bookings are permanent records: nobody can delete them.
      allow delete: if isAdmin() && resource.data.get('status', '') != 'completed';
    }

    match /messages/{messageId} {

      allow read: if true;

      // Customers (signed in or not) can send; only staff/admin may post
      // as the business side (fromStaff: true).
      allow create: if request.resource.data.userId is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.fromStaff is bool
                    && request.resource.data.sentAt == request.time
                    && (request.resource.data.fromStaff == false
                        || isStaff() || isAdmin())
                    && (request.resource.data.fromStaff == true
                        || !isBlockedUser(request.resource.data.get('userId', '')));

      allow update: if false;

      // Staff/Admin can delete anything (used by "Clear chat"). A customer
      // can delete only their own messages (fromStaff == false): signed-in
      // customers by matching their uid, guests (no Firebase Auth, ids like
      // "guest-<timestamp>") by their guest id.
      allow delete: if isStaff() || isAdmin()
                    || (resource.data.fromStaff == false
                        && ((request.auth != null && resource.data.userId == request.auth.uid)
                            || (resource.data.userId is string && resource.data.userId.matches('guest-.*'))));
    }

    // Chat photos. Kept OUT of `messages` so the inboxes (which listen to
    // every message) stay small: a photo is fetched only when its bubble
    // is shown. Same base64-in-Firestore approach as receipts. The size cap
    // keeps each doc safely under Firestore's 1 MiB limit.
    match /messageImages/{imageId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['userId', 'fromStaff', 'data', 'createdAt'])
                    && request.resource.data.userId is string
                    && request.resource.data.fromStaff is bool
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 850000
                    && request.resource.data.data[0:11] == 'data:image/'
                    && (request.resource.data.fromStaff == false
                        || isStaff() || isAdmin())
                    && (request.resource.data.fromStaff == true
                        || !isBlockedUser(request.resource.data.get('userId', '')));

      allow update: if false;
      // A customer may remove a photo they sent themselves (same rule as
      // deleting their message above).
      allow delete: if isStaff() || isAdmin()
                    || (resource.data.fromStaff == false
                        && ((request.auth != null && resource.data.userId == request.auth.uid)
                            || (resource.data.userId is string && resource.data.userId.matches('guest-.*'))));
    }

    // Staff post/pin/delete announcements (e.g. "Photobooth is closed
    // today"); every customer can read them, signed in or not.
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && (isStaff() || isAdmin());
    }

    // Photos staff take during an event. Each one belongs to one booking and
    // one customer (userId): only that signed-in customer, or staff/admin,
    // can read it. Only staff/admin can add or remove photos.
    match /eventPhotos/{photoId} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isStaff() || isAdmin());

      allow create: if (isStaff() || isAdmin())
                    && request.resource.data.keys().hasOnly(
                         ['bookingId', 'userId', 'data', 'uploadedByStaffId', 'uploadedByStaffName', 'createdAt'])
                    && request.resource.data.bookingId is string
                    && request.resource.data.userId is string
                    && request.resource.data.data is string
                    && request.resource.data.data.size() < 850000
                    && request.resource.data.data[0:11] == 'data:image/'
                    && request.resource.data.createdAt == request.time
                    // Photos only for a confirmed booking whose event is today.
                    // The 36h window covers the Philippine timezone and the
                    // midnight-local date stored on bookings.
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status in ['confirmed', 'completed']
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.date > request.time - duration.value(36, 'h')
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.date < request.time + duration.value(36, 'h');

      allow update: if false;
      allow delete: if isStaff() || isAdmin();
    }

    // A customer's refund request on their own paid booking. Only the
    // customer who owns the booking can create one, and only while it's
    // confirmed. Staff/admin read it and change its status; the customer
    // can't edit or delete it afterwards.
    match /refundRequests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isStaff() || isAdmin());
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['bookingId', 'userId', 'reason', 'status', 'createdAt'])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.bookingId is string
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() > 0
                    && request.resource.data.reason.size() <= 500
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'confirmed';
      allow update, delete: if isStaff() || isAdmin();
    }

    match /feedback/{feedbackId} {
    
      allow create: if !isBlockedUser(request.resource.data.get('userId', ''));

      allow read: if true;

      // Admin can reply to a review or hide/unhide it — nothing else
      // (rating and comment can never be edited).
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['adminReply', 'adminReplyAt', 'hidden']);

      allow delete: if isAdmin();
    }

    // Customers (even guests) can create a rental, but only with the fields
    // the customer app sends and never already "returned". Only staff/admin
    // can change a rental afterwards (check-in, fees, deposit, acknowledge).
    match /cameraRentals/{rentalId} {
      allow create: if !isBlockedUser(request.resource.data.get('userId', ''))
                    && request.resource.data.get('returnedAt', null) == null
                    && (isStaff() || isAdmin()
                        || request.resource.data.keys().hasOnly([
                             'userId', 'cameraId', 'cameraName', 'dailyRate', 'totalPrice',
                             'durationHours', 'rentedAt', 'dueAt', 'returnedAt', 'acknowledged']));
      allow read: if true;
      allow update: if isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // One doc per camera that is out. It can only be created together with
    // its rental (same transaction) and only staff/admin can free it.
    match /cameraLocks/{cameraId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['rentalId', 'dueAt'])
                    && request.resource.data.rentalId is string
                    && existsAfter(/databases/$(database)/documents/cameraRentals/$(request.resource.data.rentalId));
      allow update: if false;
      allow delete: if isStaff() || isAdmin();
    }

    // Customers an admin has blocked (abusive / no-show). Everyone can read
    // (so the apps can say "your account is restricted"); only admin writes.
    match /blockedUsers/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-customer message thread state (closed/open). A new message from
    // the customer after `closedAt` re-opens the thread automatically.
    match /threadStatus/{userId} {
      allow read: if request.auth != null && (isStaff() || isAdmin());
      allow write: if request.auth != null && (isStaff() || isAdmin());
    }

    // Everyone can read prices; only an admin can change them.
    match /pricing/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App-wide settings (e.g. settings/payment — the downpayment rule).
    // Everyone can read it so checkout can show the right amount; only an
    // admin can change it.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dateHolds/{dateKey} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Used only to read Firebase's server time (see ServerClock). A doc may
    // contain nothing but its own server timestamp.
    match /serverClock/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['t'])
                            && request.resource.data.t == request.time;
      allow delete: if false;
    }

    // Forgot-password daily cap (3 per email per day). Used before login, so no auth check.
    match /resetLimits/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['day', 'count', 'updatedAt'])
                            && request.resource.data.day is string
                            && request.resource.data.count is int
                            && request.resource.data.count >= 1
                            && request.resource.data.count <= 50;
      allow delete: if false;
    }

    // Running invoice number. Can only ever go up by exactly 1.
    match /counters/{id} {
      allow read: if true;
      allow create: if id == 'invoice' && request.resource.data.n == 1;
      allow update: if id == 'invoice' && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff() || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /staff/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Admins manage staff records. A staff member may only save their own
      // push token (fcmTokens) so the Cloud Functions can notify this phone.
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (request.auth != null
                        && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin();
      // Admin accounts are protected: nobody (not even another admin) can
      // delete an admin access doc from the client.
      allow delete: if false;
    }

    match /posTransactions/{transactionId} {
      allow create: if request.auth != null && (isStaff() || isAdmin());
      allow read: if request.auth != null && (isStaff() || isAdmin());
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /shiftClosings/{closingId} {
      allow create: if request.auth != null && isStaff() && request.resource.data.staffId == request.auth.uid;
      allow read: if request.auth != null && (isStaff() || isAdmin());
      allow update: if false;
      allow delete: if false;
    }

    match /activityLog/{entryId} {
      allow create: if request.auth != null && (isStaff() || isAdmin());
      allow read: if request.auth != null && (isStaff() || isAdmin());
      allow update: if false;
      allow delete: if false;
    }

    // Duplicate-email check used by the User app's registration screen
    // (see AuthService.emailHasAccount). Anyone can look an email up; only
    // a signed-in person can add one, and entries can't be edited/removed.
    match /emailIndex/{key} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if false;
      // Deleting your own account frees your email address again: you can
      // only remove the entry for the email you are signed in with.
      allow delete: if request.auth != null
                    && request.auth.token.email != null
                    && request.auth.token.email.lower() == key;
    }

    // What a customer (possibly a guest with no login) may change on a booking.
    function customerBookingEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
          resource.data.status == 'awaiting_receipt'
          && changed.hasOnly([
               // updateReservation
               'packageId', 'packageName', 'duration', 'price', 'addOnNames', 'addOns', 'addOnsPrice',
               'date', 'time', 'guests', 'location', 'locationLat', 'locationLng',
               // attachReceipt
               'receiptFileName', 'receiptUrl', 'paymentOption', 'amountPaid', 'balanceDue',
               'balancePaid', 'status', 'holdExpiresAt', 'receiptSubmittedAt', 'receiptRefNo',
               'receiptOcrAmount',
               // expireHold
               'rejectionReason', 'autoRejected', 'statusUpdatedAt'])
          && request.resource.data.status in ['awaiting_receipt', 'pending_confirmation', 'cancelled']
        )
        || (changed.hasOnly(['notifyCustomer']) && request.resource.data.notifyCustomer == false)
        || (changed.hasOnly(['invoiceNo']) && !('invoiceNo' in resource.data));
    }

    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isBlockedUser(uid) {
      return uid is string && exists(/databases/$(database)/documents/blockedUsers/$(uid));
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
