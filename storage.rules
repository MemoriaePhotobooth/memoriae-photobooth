rules_version = '2';

// Starter rules for payment receipt uploads. Receipts are written to
// receipts/{userId}/{filename} by the User app and read back by both apps
// for previewing in the staff dashboard's lightbox.
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{userId}/{fileName} {
      // Anyone can upload/read for now, matching the demo's local auth.
      // Once Firebase Auth is wired up, scope this to:
      //   allow write: if request.auth != null && request.auth.uid == userId;
      //   allow read: if request.auth != null; // staff + the owning customer
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
